# MongoDB Connection URI
# For MongoDB Atlas: Replace <username>, <password>, <cluster-url>, and <dbname> with your actual credentials.
# Ensure your username and password are URL-encoded if they contain special characters.
# Example: MONGO_URI_ATLAS=mongodb+srv://<username>:<password>@<cluster-url>/<dbname>?retryWrites=true&w=majority

# For Local MongoDB:
# Example: MONGO_URI_LOCAL=mongodb://127.0.0.1:27017/<dbname>

# Choose one of the above and assign it to MONGO_URI
MONGO_URI=

# JWT Secret for authentication
JWT_SECRET=YOUR_JWT_SECRET_HERE

# Port for the backend server
PORT=5000

# Cloudinary API credentials (if applicable)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
